# Copy this file to config/runtime.env and fill in your local deployment values.
# All scripts under scripts/ load it automatically.

# Build output
# You can keep BUILD_DIR fixed, or temporarily override it when launching:
#   CMM_BUILD_TYPE=Release /Users/achang/cmm_runtime/scripts/start_backend.sh
BUILD_DIR=/Users/achang/cmm_runtime/build/Qt_6_10_1_for_macOS-Debug

# Backend
BACKEND_URL=http://127.0.0.1:8080
SIM_BIND_HOST=127.0.0.1
SIM_BACKEND_PORT=8080
SIM_HTTP_WORKER_THREADS=128
SIM_HTTP_KEEP_ALIVE_MAX_COUNT=4
SIM_HTTP_KEEP_ALIVE_TIMEOUT_SEC=2

# Database
SIM_DB_DRIVER=QMYSQL
SIM_DB_HOST=127.0.0.1
SIM_DB_PORT=3307
SIM_DB_NAME=cmm_sim
SIM_DB_USER=root
SIM_DB_PASS=replace_with_your_real_password

# MQTT
SIM_MQTT_URL=tcp://127.0.0.1:1883
SIM_COMMAND_TRACE=false

# Device simulator diagnostics
SIM_DEVICE_DELAY_MIN_MS=500
SIM_DEVICE_DELAY_MAX_MS=1800
SIM_DEVICE_FAULT_PERCENT=1.8
SIM_DEVICE_RANDOM_DELAY=false

# Frontend / simulator defaults
ROOM_ID=
SIM_DEVICE_HEADLESS=0
