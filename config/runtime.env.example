# Copy this file to config/runtime.env and fill in your local deployment values.
# All scripts under scripts/ load it automatically.

# Build output
BUILD_DIR=/Users/achang/Desktop/multimedia_classroom_monitor/build/Qt_6_10_1_for_macOS-Debug

# Backend
BACKEND_URL=http://127.0.0.1:8080
SIM_BIND_HOST=127.0.0.1
SIM_BACKEND_PORT=8080

# Database
SIM_DB_DRIVER=QMYSQL
SIM_DB_HOST=127.0.0.1
SIM_DB_PORT=3307
SIM_DB_NAME=cmm_sim
SIM_DB_USER=root
SIM_DB_PASS=replace_with_your_real_password

# MQTT
SIM_MQTT_URL=tcp://127.0.0.1:1883

# Frontend / simulator defaults
ROOM_ID=A101
SIM_DEVICE_HEADLESS=0
